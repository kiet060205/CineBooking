# ============================================================
# CineBooking / Hotel Management System - .env (Sample Config)
# Sao chép file này thành .env và chỉnh sửa cho phù hợp môi trường của bạn.
# Lưu ý: Đừng commit file .env lên Git (nếu dùng Git).
# ============================================================

# --- Môi trường ---
ASPNETCORE_ENVIRONMENT=Development

# --- Cổng chạy (nếu cần override) ---
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# --- Chuỗi kết nối SQL Server ---
ConnectionStrings__DefaultConnection=Server=.\\SQLEXPRESS;Database=HotelManagementDB;Trusted_Connection=True;TrustServerCertificate=True;

# --- JWT Authentication ---
Jwt__Key=MotChuoiBimatRatDaiVaKhoDoanChoHeThongKhachSan2026
Jwt__Issuer=HotelApi
Jwt__Audience=HotelClients

# --- MoMo Payment Gateway (Sandbox/Test) ---
MoMo__PartnerCode=MOMO
MoMo__AccessKey=F8BBA842ECF85
MoMo__SecretKey=K951B6PE1waDMi640xX08PD3vg6EkVlz
MoMo__Endpoint=https://test-payment.momo.vn/v2/gateway/api/create
MoMo__RedirectUrl=http://localhost:5173/my-bookings
MoMo__IpnUrl=https://webhook.site/b3088a6a-2d17-4f8d-a383-71389a6c600b
MoMo__RequestType=captureWallet

# --- CORS (cho phép mọi nguồn trong môi trường phát triển) ---
CORS__AllowedOrigins=http://localhost:5173

# ============================================================
# Variables cho Frontend (React + Vite) - nếu dùng Vite .env:
# Các biến bắt đầu bằng VITE_ sẽ được ti vào import.meta.env
# ============================================================

VITE_API_BASE_URL=http://localhost:5262
VITE_APP_TITLE=CineBooking
